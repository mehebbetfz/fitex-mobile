{
	"expo": {
		"name": "Fitex",
		"owner": "mehebbet55",
		"slug": "fitex",
		"version": "1.0.0",
		"orientation": "portrait",
		"scheme": "fitex",
		"userInterfaceStyle": "automatic",
		"splash": {
			"image": "./assets/images/logo.png",
			"resizeMode": "contain",
			"backgroundColor": "#121212"
		},
		"assetBundlePatterns": ["**/*"],
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.farzaliyev.fitex",
			"entitlements": {
				"com.apple.developer.applesignin": ["Default"]
			},
			"infoPlist": {
				"CFBundleURLTypes": [
					{
						"CFBundleURLSchemes": ["fitex"]
					},
					{
						"CFBundleURLSchemes": ["fitex"]
					}
				],
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#121212"
			},
			"package": "com.yourcompany.fitex",
			"intentFilters": [
				{
					"action": "VIEW",
					"data": [
						{
							"scheme": "fitex"
						}
					],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			]
		},
		"web": {
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			"expo-sqlite",
			"expo-video",
			"react-native-iap",
			"expo-asset",
			[
				"expo-file-system",
				{
					"supportsOpeningDocumentsInPlace": true,
					"enableFileSharing": true
				}
			]
		],
		"extra": {
			"router": {
				"origin": false
			},
			"eas": {
				"projectId": "d0bea795-3395-48ff-b6b0-acac835c2a24"
			}
		}
	}
}
